// Interactions
const multiSelections = {};

function selectOption(pageId, idx, type, value) {
  if (type === 'multi') {
    if (!multiSelections[pageId]) multiSelections[pageId] = new Set();
    const card = document.getElementById('card-' + pageId + '-' + idx);
    if (multiSelections[pageId].has(idx)) {
      multiSelections[pageId].delete(idx);
      card.classList.remove('selected');
    } else {
      multiSelections[pageId].add(idx);
      card.classList.add('selected');
    }
    const selectedValues = [...multiSelections[pageId]].map(i => {
      const pg = pages.find(p => p.id === pageId);
      return pg.options[i];
    });
    state.answers[pageId] = selectedValues;
    document.getElementById('btn-' + pageId).disabled = multiSelections[pageId].size === 0;
  } else {
    // Single
    document.querySelectorAll(`[id^="card-${pageId}-"]`).forEach(c => c.classList.remove('selected'));
    document.getElementById('card-' + pageId + '-' + idx).classList.add('selected');
    state.answers[pageId] = value;
    document.getElementById('btn-' + pageId).disabled = false;
  }
}

function onTextInput(pageId, key, value) {
  state.answers[pageId] = value;
  if (key === 'name') state.name = value.trim();
  if (key === 'whatsapp') state.whatsapp = value.trim();
  document.getElementById('btn-' + pageId).disabled = value.trim().length === 0;
}

function checkPhysical() {
  const age = document.getElementById('input-age').value;
  const weight = document.getElementById('input-weight').value;
  const height = document.getElementById('input-height').value;
  state.answers[9] = { age, weight, height };
  document.getElementById('btn-10').disabled = !(age && weight && height);
}

function nextPage(currentId) {
  if (currentId === 15) {
    // Check qualification
    if (qualify()) {
      document.getElementById('qual-title').textContent = 'PERFEITO, ' + state.name.split(' ')[0].toUpperCase() + '!';
      document.getElementById('qual-text').innerHTML = `Suas respostas mostram que você está <strong>pronto para mudar</strong>. O próximo passo é agendar sua avaliação gratuita. É rápido, sem compromisso e 100% focado no seu caso.`;
      renderPage('qualified');
    } else {
      document.getElementById('disq-title').textContent = state.name.split(' ')[0] + ', obrigado por responder.';
      renderPage('disqualified');
    }
    return;
  }
  state.current = currentId + 1;
  renderPage(currentId + 1);
}

function goBack(currentId) {
  if (currentId <= 1) return;
  state.current = currentId - 1;
  renderPage(currentId - 1);
}

function goToScheduling() {
  renderPage('scheduling');
}

function selectDay(day) {
  state.scheduledDay = day;
  state.scheduledTime = '';

  document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('day-' + day).classList.add('selected');

  const isSaturday = day === 'Sábado';
  const times = isSaturday ? ['10h00', '11h00', '12h00', '14h00'] : ['13h00', '14h00', '15h00', '20h00'];

  const timesGrid = document.getElementById('times-grid');
  timesGrid.innerHTML = times.map(t => `
    <button class="time-btn" id="time-${t}" onclick="selectTime('${t}')">${t}</button>
  `).join('');

  document.getElementById('times-section').style.display = 'block';
  document.getElementById('btn-confirm').disabled = true;
}

function selectTime(time) {
  state.scheduledTime = time;
  document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('time-' + time).classList.add('selected');
  document.getElementById('btn-confirm').disabled = false;
}

function confirmScheduling() {
  const name = state.name.split(' ')[0];
  document.getElementById('conf-text').innerHTML = `<strong>${name}</strong>, seu agendamento está confirmado!`;
  document.getElementById('conf-box').innerHTML = `
    <div class="conf-row">
      <span class="conf-key">📅 Dia</span>
      <span class="conf-val">${state.scheduledDay}</span>
    </div>
    <div class="conf-row">
      <span class="conf-key">⏰ Horário</span>
      <span class="conf-val">${state.scheduledTime}</span>
    </div>
    <div class="conf-row">
      <span class="conf-key">📱 WhatsApp</span>
      <span class="conf-val">${state.whatsapp}</span>
    </div>
    <div class="conf-row">
      <span class="conf-key">🎯 Tipo</span>
      <span class="conf-val">Avaliação Gratuita</span>
    </div>
  `;
  renderPage('confirmation');
  sendWhatsAppBriefing();
}


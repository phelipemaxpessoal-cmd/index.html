      'Estou satisfeito assim'
    ]
  },
  {
    id: 6,
    type: 'single',
    question: 'Se você encontrasse um protocolo de treino e dieta que mudasse o corpo entre 60 e 90 dias, você estaria disposto a investir hoje?',
    options: [
      'Sim, estaria disposto',
      'Gostaria, mas não posso neste momento',
      'Não estaria disposto'
    ]
  },
  {
    id: 7,
    type: 'single',
    question: 'Quanto você costuma investir por mês em cuidados com o seu corpo?',
    options: [
      'R$0 a R$50',
      'R$51 a R$100',
      'R$101 a R$150',
      'R$151 a R$200',
      'R$201 a R$300',
      'R$301 a R$500',
      'R$501 a R$1.000',
      'Mais de R$1.000'
    ]
  },
  {
    id: 8,
    type: 'single',
    question: 'Qual é o maior obstáculo que te impede de ter o corpo que você quer hoje?',
    options: [
      'Falta de tempo',
      'Não sei o que fazer / falta de conhecimento',
      'Falta de disciplina e consistência',
      'Já tentei mas não tive resultado',
      'Não tenho acompanhamento profissional'
    ]
  },
  {
    id: 9,
    type: 'text',
    question: 'Com o que você trabalha?',
    placeholder: 'Digite sua profissão...',
    key: 'job'
  },
  {
    id: 10,
    type: 'physical',
    title: 'Seus dados físicos.'
  },
  {
    id: 11,
    type: 'single',
    question: 'Quantas vezes você treina por semana?',
    options: [
      'Não treino',
      '1 a 2x por semana',
      '3 a 4x por semana',
      '5 a 6x por semana',
      'Todos os dias'
    ]
  },
  {
    id: 12,
    type: 'objective',
    question: 'Qual é o seu objetivo?',
    options: [
      { icon: '🔥', title: 'Emagrecimento', desc: 'Reduzir gordura corporal com leveza, saúde e consistência.' },
      { icon: '💪', title: 'Hipertrofia', desc: 'Aumentar massa muscular e conquistar um corpo mais forte.' },
      { icon: '⚡', title: 'Recomposição corporal', desc: 'Perder gordura e ganhar músculo ao mesmo tempo.' }
    ]
  },
  {
    id: 13,
    type: 'text',
    question: 'Qual é o seu nome?',
    placeholder: 'Digite seu nome...',
    key: 'name'
  },
  {
    id: 14,
    type: 'text',
    question: 'Qual o seu @ do Instagram?',
    placeholder: '@seuinstagram',
    key: 'instagram'
  },
  {
    id: 15,
    type: 'text',
    question: 'Qual seu WhatsApp?',
    placeholder: '(00) 00000-0000',
    key: 'whatsapp'
  }
];

function qualify() {
  const p5 = state.answers[5];
  const p6 = state.answers[6];
  const p7 = state.answers[7];

  const c1 = p5 === 'Tenho muita vontade e é prioridade' || p5 === 'Quero mudar, mas não é prioridade';
  const c2 = p6 === 'Sim, estaria disposto' || p6 === 'Gostaria, mas não posso neste momento';
  const disqualifiedValues = ['R$0 a R$50', 'R$51 a R$100'];
  const c3 = !disqualifiedValues.includes(p7);

  return c1 && c2 && c3;
}

function renderPage(num) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const el = document.getElementById('page-' + num);
  if (el) el.classList.add('active');
}

function buildPages() {
  const body = document.body;

  pages.forEach((pg) => {
    const div = document.createElement('div');
    div.className = 'page';
    div.id = 'page-' + pg.id;

    div.innerHTML = `
      <div class="header">
        ${pg.id > 1 ? `<button class="btn-back" onclick="goBack(${pg.id})">&#8592;</button>` : '<div></div>'}
        <div class="logo"><img src="data:image/png;base64," alt="Phelipe Max Personal Trainer"/></div>
        <div class="progress-label">${pg.id} de ${totalPages}</div>
      </div>
      <div class="progress-wrap">
        <div class="progress-track">
          <div class="progress-fill" style="width:${(pg.id/totalPages)*100}%"></div>
        </div>
      </div>
      <div class="content" id="content-${pg.id}"></div>
    `;

    body.appendChild(div);
    buildContent(pg);
  });

  // Build special pages
  buildQualifiedTransition();
  buildScheduling();
  buildConfirmation();
  buildDisqualified();
}

function buildContent(pg) {
  const content = document.getElementById('content-' + pg.id);

  if (pg.type === 'multi' || pg.type === 'single') {
    content.innerHTML = `
      <div class="question">${pg.question}</div>
      ${pg.type === 'multi' ? '<div class="subtitle">Selecione todas que se aplicam</div>' : '<div class="subtitle">Selecione uma opção</div>'}
      <div class="options" id="opts-${pg.id}">
        ${pg.options.map((opt, i) => `
          <div class="card" id="card-${pg.id}-${i}" onclick="selectOption(${pg.id}, ${i}, '${pg.type}', \`${opt.replace(/`/g,'\\`')}\`)">
            <div class="card-text">${opt}</div>
            <div class="card-check">✓</div>
          </div>
        `).join('')}
      </div>
      <button class="btn-continue" id="btn-${pg.id}" onclick="nextPage(${pg.id})" disabled>CONTINUAR</button>
    `;
  } else if (pg.type === 'text') {
    content.innerHTML = `
      <div class="question">${pg.question}</div>
      <div class="subtitle" style="margin-bottom:32px">CAMPO ABERTO</div>
      <input class="input-field" id="input-${pg.id}" type="text" placeholder="${pg.placeholder}" 
             oninput="onTextInput(${pg.id}, '${pg.key}', this.value)" style="margin-top:8px"/>
      <button class="btn-continue" id="btn-${pg.id}" onclick="nextPage(${pg.id})" disabled>CONTINUAR</button>
    `;
  } else if (pg.type === 'physical') {
    content.innerHTML = `
      <div class="question">${pg.title}</div>
      <div class="subtitle" style="margin-bottom:28px">PREENCHA SEUS DADOS</div>
      <div>
        <label class="input-label">Idade</label>
        <input class="input-field" id="input-age" type="number" placeholder="Ex: 28" oninput="checkPhysical()"/>
        <label class="input-label">Peso (kg)</label>
        <input class="input-field" id="input-weight" type="number" placeholder="Ex: 75" oninput="checkPhysical()"/>
        <label class="input-label">Altura (cm)</label>
        <input class="input-field" id="input-height" type="number" placeholder="Ex: 175" oninput="checkPhysical()"/>
      </div>
      <button class="btn-continue" id="btn-${pg.id}" onclick="nextPage(${pg.id})" disabled>CONTINUAR</button>
    `;
  } else if (pg.type === 'objective') {
    content.innerHTML = `
      <div class="question">${pg.question}</div>
      <div class="subtitle" style="margin-bottom:24px">SELECIONE UMA OPÇÃO</div>
      <div class="options" id="opts-${pg.id}">
        ${pg.options.map((opt, i) => `
          <div class="card card-obj" id="card-${pg.id}-${i}" onclick="selectOption(${pg.id}, ${i}, 'single', \`${opt.title.replace(/`/g,'\\`')}\`)">
            <div class="card-obj-header">
              <div class="card-obj-icon">${opt.icon}</div>
              <div>
                <div class="card-obj-title">${opt.title}</div>
                <div class="card-check" style="display:none">✓</div>
              </div>
              <div class="card-check" style="margin-left:auto">✓</div>
            </div>
            <div class="card-obj-desc">${opt.desc}</div>
          </div>
        `).join('')}
      </div>
      <button class="btn-continue" id="btn-${pg.id}" onclick="nextPage(${pg.id})" disabled>CONTINUAR</button>
    `;
  }
}

function buildQualifiedTransition() {
  const div = document.createElement('div');
  div.className = 'page';
  div.id = 'page-qualified';
  div.innerHTML = `
    <div class="header" style="padding:18px 24px 0">
      <div></div>
      <div class="logo"><img src="data:image/png;base64," alt="Phelipe Max Personal Trainer"/></div>
      <div></div>
    </div>
    <div class="content">
      <div class="result-page">
        <div class="result-icon">🎯</div>
        <div class="result-title" id="qual-title">PERFEITO!</div>
        <p class="result-text" id="qual-text"></p>
        <button class="btn-continue" style="max-width:400px" onclick="goToScheduling()">AGENDAR AGORA</button>
      </div>
    </div>
  `;
  document.body.appendChild(div);
}

function buildScheduling() {
  const div = document.createElement('div');
  div.className = 'page';
  div.id = 'page-scheduling';

  const weekdays = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'];

  div.innerHTML = `
    <div class="header" style="padding:18px 24px 0">
      <div></div>

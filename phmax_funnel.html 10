<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PHMAX – Avaliação Gratuita</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #000000;
    --white: #FFFFFF;
    --green: #B4FF2E;
    --green-dim: rgba(180,255,46,0.12);
    --green-glow: rgba(180,255,46,0.28);
    --gray: #111111;
    --gray2: #1a1a1a;
    --muted: #777777;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { background: #000000; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Subtle grid background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(180,255,46,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(180,255,46,0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .page {
    display: none;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }
  .page.active { display: flex; }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px 0;
    position: relative;
  }

  .btn-back {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 22px;
    transition: color 0.2s;
    padding: 4px;
  }
  .btn-back:hover { color: var(--white); }

  .logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
  }
  .logo img {
    height: 64px;
    width: auto;
    display: block;
  }

  .progress-label {
    font-size: 12px;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 1px;
  }

  /* Progress bar */
  .progress-wrap {
    padding: 14px 24px 0;
  }
  .progress-track {
    height: 3px;
    background: rgba(255,255,255,0.08);
    border-radius: 99px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--green);
    border-radius: 99px;
    transition: width 0.4s cubic-bezier(0.4,0,0.2,1);
    box-shadow: 0 0 10px var(--green-glow);
  }

  /* Content area */
  .content {
    flex: 1;
    padding: 32px 24px 24px;
    display: flex;
    flex-direction: column;
    max-width: 640px;
    margin: 0 auto;
    width: 100%;
  }

  .question {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(26px, 5vw, 38px);
    line-height: 1.1;
    letter-spacing: 1px;
    color: var(--white);
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 28px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  /* Cards */
  .options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card {
    background: var(--gray);
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 18px 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 17px;
    font-weight: 500;
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    position: relative;
    overflow: hidden;
    line-height: 1.4;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--green-dim);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .card:hover {
    border-color: rgba(180,255,46,0.4);
  }

  .card.selected {
    border-color: var(--green);
    box-shadow: 0 0 18px var(--green-glow), inset 0 0 0 1px var(--green);
  }
  .card.selected::before { opacity: 1; }

  .card-check {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.25);
    background: transparent;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0px;
    font-weight: 700;
    color: #000000;
    transition: all 0.2s;
    position: relative;
    z-index: 1;
  }
  .card.selected .card-check {
    background: var(--green);
    border-color: var(--green);
    color: var(--black);
    font-size: 14px;
  }

  .card-text { position: relative; z-index: 1; line-height: 1.3; }

  /* Objective cards with visual */
  .card-obj {
    flex-direction: column;
    align-items: flex-start;
    padding: 18px;
  }
  .card-obj-header {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
  }
  .card-obj-icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--gray2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.07);
  }
  .card-obj-title { font-size: 17px; font-weight: 900; }
  .card-obj-desc {
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
    position: relative;
    z-index: 1;
    padding-left: 56px;
  }

  /* Input fields */
  .input-field {
    background: var(--gray);
    border: 1.5px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 16px 18px;
    font-size: 16px;
    color: var(--white);
    font-family: 'Barlow', sans-serif;
    font-weight: 600;
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
    margin-bottom: 12px;
  }
  .input-field:focus {
    border-color: var(--green);
    box-shadow: 0 0 12px var(--green-glow);
  }
  .input-field::placeholder { color: var(--muted); font-weight: 400; }

  .input-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 8px;
    display: block;
  }

  .fields-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px;
  }

  /* CTA Button */
  .btn-continue {
    background: var(--green);
    color: var(--black);
    border: none;
    border-radius: 10px;
    padding: 18px 24px;
    font-family: 'Barlow', sans-serif;
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
    margin-top: 20px;
    box-shadow: 0 4px 24px var(--green-glow);
  }
  .btn-continue:hover {
    background: #00e84d;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px var(--green-glow);
  }
  .btn-continue:active { transform: translateY(0); }
  .btn-continue:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  /* Scheduling */
  .days-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 24px;
  }
  .day-btn {
    background: var(--gray);
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    padding: 14px 8px;
    color: var(--white);
    font-family: 'Barlow', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }
  .day-btn:hover { border-color: rgba(0,204,68,0.4); }
  .day-btn.selected {
    border-color: var(--green);
    box-shadow: 0 0 14px var(--green-glow);
    color: var(--green);
  }

  .times-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 8px;
  }
  .time-btn {
    background: var(--gray);
    border: 1.5px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    padding: 14px 8px;
    color: var(--white);
    font-family: 'Barlow', sans-serif;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }
  .time-btn:hover { border-color: rgba(0,204,68,0.4); }
  .time-btn.selected {
    border-color: var(--green);
    box-shadow: 0 0 14px var(--green-glow);
    color: var(--green);
  }

  .section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--green);
    margin-bottom: 12px;
  }

  /* Result pages */
  .result-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 28px;
    max-width: 560px;
    margin: 0 auto;
    width: 100%;
  }

  .result-icon {
    font-size: 56px;
    margin-bottom: 24px;
  }

  .result-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(32px, 7vw, 50px);
    letter-spacing: 2px;
    color: var(--green);
    margin-bottom: 16px;
    text-shadow: 0 0 30px var(--green-glow);
    line-height: 1;
  }

  .result-text {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255,255,255,0.85);
    margin-bottom: 36px;
    font-weight: 400;
  }

  .result-text strong { color: var(--white); font-weight: 700; }

  .disqualified-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(26px, 6vw, 40px);
    letter-spacing: 1px;
    color: var(--white);
    margin-bottom: 16px;
  }

  .instagram-handle {
    font-size: 20px;
    font-weight: 900;
    color: var(--green);
    letter-spacing: 1px;
  }

  .confirmation-box {
    background: var(--gray);
    border: 1.5px solid var(--green);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 24px;
    width: 100%;
    box-shadow: 0 0 30px var(--green-glow);
  }
  .conf-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    font-size: 14px;
  }
  .conf-row:last-child { border-bottom: none; }
  .conf-key { color: var(--muted); font-weight: 600; }
  .conf-val { color: var(--white); font-weight: 700; }

  /* Pulse animation on logo */
  @keyframes pulse-green {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; filter: drop-shadow(0 0 8px rgba(180,255,46,0.5)); }
  }
  .logo img { animation: pulse-green 3s ease-in-out infinite; }

  /* Fade in animation */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .page.active { animation: fadeIn 0.35s ease forwards; }

  /* Scrollable content on smaller screens */
  .content { overflow-y: auto; }

  @media (max-width: 400px) {
    .fields-row { grid-template-columns: 1fr; }
    .days-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
<body>

<!-- PAGES 1-14 generated by JS below -->

<script>
const state = {
  current: 1,
  answers: {},
  name: '',
  whatsapp: '',
  scheduledDay: '',
  scheduledTime: ''
};

const totalPages = 15;

const pages = [
  {
    id: 1,
    type: 'multi',
    question: 'Você já tentou algumas dessas coisas para melhorar o seu corpo nos últimos 6 meses?',
    subtitle: 'SELEÇÃO MÚLTIPLA',
    options: [
      'Fiz o uso de medicamentos ou hormônios',
      'Fiz procedimentos estéticos',
      'Passei por consulta com médico ou nutricionista',
      'Fiz acompanhamento com personal',
      'Fiz o uso de suplementos',
      'Nenhum dos anteriores'
    ]
  },
  {
    id: 2,
    type: 'single',
    question: 'Usa suplementos? Se sim, quantos por dia?',
    options: [
      'Não uso nenhum',
      'Uso 1 suplemento',
      'Uso 2 suplementos',
      'Uso 3 suplementos',
      'Uso 4 ou mais suplementos'
    ]
  },
  {
    id: 3,
    type: 'single',
    question: 'Você já teve algum acompanhamento individual?',
    options: [
      'Sim, acompanhamento nutricional',
      'Sim, consultoria de treino',
      'Sim, os dois',
      'Nunca tive'
    ]
  },
  {
    id: 4,
    type: 'single',
    question: 'Com as estratégias que você está seguindo, você acredita que vai ter o corpo que deseja?',
